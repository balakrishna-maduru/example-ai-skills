{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JiraCreateTicketOutput",

  "type": "object",

  "required": [
    "success"
  ],

  "properties": {

    "success": {
      "type": "boolean"
    },

    "issue_key": {
      "type": "string"
    },

    "issue_url": {
      "type": "string"
    },

    "error": {
      "type": "object",

      "properties": {

        "code": {
          "type": "string"
        },

        "message": {
          "type": "string"
        }
      }
    }
  },

  "additionalProperties": false
}